+/**
+ * The request as an Effect request with its query exactly as the caller wrote it. `fromWeb` reads the query
+ * into parameters, which are sent re-encoded as form fields (`%20` as `+`, commas and slashes escaped), so the
+ * parameters are cleared and the URL, without its fragment, is set again as written.
+ */
+const asSent = (request: Request) => {
+  const url = new URL(request.url);
+  url.hash = "";
+  const written = url.href;
+  url.search = "";
+  return HttpClientRequest.fromWeb(request).pipe(
+    HttpClientRequest.setUrl(url),
+    HttpClientRequest.setUrl(written),
+  );
+};
